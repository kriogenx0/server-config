# Installed once, by hand, as admin (deploy has no sudo to install its own
# rules): see deploy.sh's header for the exact command. Scoped narrowly to
# this domain only, matching every other app on this host (check
# `sudo -n -l` as deploy to see the rest).
# (File name has no dots: sudo ignores /etc/sudoers.d files whose names contain one.)
deploy ALL=(root) NOPASSWD: /bin/cp /tmp/thefword.site.bootstrap.conf /etc/nginx/sites-available/thefword.site, /bin/cp /tmp/thefword.site.conf /etc/nginx/sites-available/thefword.site, /usr/bin/certbot certonly --webroot -w /var/www/certbot -d thefword.site -d www.thefword.site --non-interactive --agree-tos -m simplex0@gmail.com --deploy-hook systemctl reload nginx
